<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RTL-TCP-Cast</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/rtl-tcp-cast.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../RtlCast.Core/RtlCast.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/rtl-tcp-cast.ico" />
  </ItemGroup>
</Project>
