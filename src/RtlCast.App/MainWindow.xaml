<Window x:Class="RtlCast.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RTL-TCP-CAST" Icon="Assets/rtl-tcp-cast.ico" Width="780" Height="800" MinWidth="660" MinHeight="540" ResizeMode="CanResizeWithGrip"
 Style="{StaticResource {x:Type Window}}" Closing="Window_Closing">
 <DockPanel Background="#F0F0F0">
  <Menu DockPanel.Dock="Top">
   <MenuItem Header="ファイル(_F)">
    <MenuItem Header="設定ファイルのインポート…" Click="ImportSettings_Click" />
    <MenuItem Header="設定ファイルのエクスポート…" Click="ExportSettings_Click" />
    <Separator />
    <MenuItem Header="終了(_X)" Click="Exit_Click" />
   </MenuItem>
   <MenuItem Header="設定(_S)"><MenuItem x:Name="SerialNumberMenu" Header="RTL-SDRシリアル番号変更…" Click="SerialNumber_Click" /><Separator /><MenuItem Header="アプリ全体の設定…" Click="Settings_Click" /></MenuItem>
   <MenuItem Header="ヘルプ(_H)">
    <MenuItem Header="ヘルプページ(_P)" Click="HelpPage_Click" />
    <MenuItem Header="バージョン情報(_A)…" Click="About_Click" />
   </MenuItem>
  </Menu>
  <Grid DockPanel.Dock="Top" Margin="6,3">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
   </Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" Orientation="Horizontal">
    <Button x:Name="StartAllButton" Content="すべて開始" Click="StartAll_Click" />
    <Button x:Name="StopAllButton" Content="すべて停止" Click="StopAll_Click" />
   </StackPanel>
   <Button Grid.Column="1" Content="アプリ終了" Click="Exit_Click" />
  </Grid>
  <StatusBar x:Name="ApplicationStatusBar" DockPanel.Dock="Bottom">
   <StatusBarItem>
    <StackPanel Orientation="Horizontal">
     <TextBlock x:Name="ApplicationStatusIndicator" Text="■" Foreground="Firebrick" Margin="0,0,3,0" />
     <TextBlock x:Name="ApplicationActivityText" Text="SDRデバイスの動作数: 0/0" />
    </StackPanel>
   </StatusBarItem>
   <StatusBarItem><TextBlock x:Name="ApplicationClientCountText" Text="全接続数: 0台" /></StatusBarItem>
   <StatusBarItem DockPanel.Dock="Right" Margin="0,0,16,0"><TextBlock x:Name="ApplicationTrafficText" Text="配信: 0.00 MB/s" /></StatusBarItem>
  </StatusBar>
  <TabControl x:Name="SessionsTabs" SelectionChanged="Tabs_SelectionChanged" />
 </DockPanel>
</Window>
