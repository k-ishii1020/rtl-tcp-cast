<Application x:Class="RtlCast.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#2563EB" />
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Yu Gothic UI" /><Setter Property="FontSize" Value="12" /><Setter Property="Background" Value="#F0F0F0" /></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="8,2" /><Setter Property="Margin" Value="0,0,4,0" /><Setter Property="MinHeight" Value="24" /></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="4,2" /><Setter Property="MinHeight" Value="24" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="4,2" /><Setter Property="MinHeight" Value="24" /></Style>
  <Style TargetType="GroupBox"><Setter Property="Padding" Value="3" /><Setter Property="Margin" Value="0,0,0,3" /></Style>
 </Application.Resources>
</Application>
