<Window x:Class="RtlCast.App.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="アプリ全体の設定" Width="540" Height="440" MinWidth="460" MinHeight="440"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
 <DockPanel Margin="12" Background="#F0F0F0">
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="OK" IsDefault="True" Click="Save_Click" MinWidth="72" />
   <Button Content="キャンセル" IsCancel="True" MinWidth="72" />
  </StackPanel>
  <StackPanel>
   <GroupBox Header="起動">
    <StackPanel>
     <CheckBox x:Name="WindowsStartupBox" Content="Windows起動時に自動起動" />
     <CheckBox x:Name="AutoStartStreamingBox" Content="アプリ起動時に自動的に配信開始する" />
    </StackPanel>
   </GroupBox>
  <GroupBox Header="RTL-TCP">
   <StackPanel>
    <TextBlock Text="実行ファイルのパス（すべての配信で共通）" Margin="0,0,0,5" />
    <DockPanel>
     <Button DockPanel.Dock="Right" Content="参照…" Click="Browse_Click" />
     <TextBox x:Name="PathBox" AutomationProperties.Name="RTL-TCPの実行ファイル" />
    </DockPanel>
    <TextBlock Text="変更は次回のRTL-TCP起動から適用されます。" Margin="0,8,0,0" />
   </StackPanel>
  </GroupBox>
   <GroupBox Header="送信バッファ（すべての配信で共通）">
    <StackPanel>
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="バッファ上限" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox x:Name="BufferCapacityBox" Width="80" AutomationProperties.Name="送信バッファ上限 ブロック" />
      <TextBlock Text="ブロック（1～8192）" VerticalAlignment="Center" Margin="8,0,0,0" />
     </StackPanel>
     <TextBlock Text="初期値1024：受信アプリごとに最大32 MiB相当。変更は次回の配信開始から適用します。" TextWrapping="Wrap" Margin="0,6,0,0" />
     <TextBlock Text="一時的な送信待ちを蓄えます。大きくすると滞留時の遅延とメモリ使用量が増えます。" TextWrapping="Wrap" Margin="0,4,0,0" />
    </StackPanel>
   </GroupBox>
  </StackPanel>
 </DockPanel>
</Window>
