<UserControl x:Class="RtlCast.App.SessionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 >
 <UserControl.Resources>
  <Style x:Key="SpinButton" TargetType="RepeatButton">
   <Setter Property="Width" Value="12" /><Setter Property="Height" Value="12" />
   <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
   <Setter Property="FontSize" Value="7" /><Setter Property="Focusable" Value="False" />
  </Style>
 </UserControl.Resources>
 <Border Padding="4" Background="#F0F0F0">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
   <RowDefinition Height="1.6*" MinHeight="110" /><RowDefinition Height="1.2*" MinHeight="85" />
  </Grid.RowDefinitions>
  <Grid Margin="0,0,0,4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="タブ名:" VerticalAlignment="Center" Margin="0,0,5,0" />
    <TextBox x:Name="SessionNameText" Text="配信 1" Width="160" MaxLength="40" LostFocus="SessionName_LostFocus" AutomationProperties.Name="タブ名" />
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button x:Name="StartStopButton" Content="配信開始" MinWidth="82" FontWeight="SemiBold" Click="StartStop_Click" Margin="0" />
   </StackPanel>
  </Grid>
  <GroupBox Grid.Row="2" Header="受信元・配信設定">
   <StackPanel>
    <StackPanel x:Name="SourcePanel">
     <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
      <RadioButton x:Name="LocalSourceRadio" Content="RTL-SDRデバイス" IsChecked="True" Margin="0,0,16,0" />
      <RadioButton x:Name="RemoteSourceRadio" Content="任意のRTL-TCP接続" />
     </StackPanel>
     <DockPanel x:Name="LocalSourcePanel" Margin="0,0,0,2">
      <TextBlock Text="SDRデバイス" Width="76" VerticalAlignment="Center" />
      <Button x:Name="RefreshDevicesButton" Content="更新" DockPanel.Dock="Right" Click="RefreshDevices_Click" />
      <ComboBox x:Name="DeviceBox" IsEditable="False" DisplayMemberPath="Label" AutomationProperties.Name="RTL-SDRデバイス" />
     </DockPanel>
     <Grid x:Name="SettingsPanel" Visibility="Collapsed" Margin="0,0,0,2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
      <TextBlock Text="接続先" VerticalAlignment="Center" />
      <TextBox x:Name="HostBox" Grid.Column="1" Text="127.0.0.1" AutomationProperties.Name="rtl_tcpの接続先" />
      <TextBlock Grid.Column="2" Text="ポート" VerticalAlignment="Center" Margin="8,0,0,0" />
      <TextBox x:Name="UpstreamPortBox" Grid.Column="3" Text="1234" AutomationProperties.Name="rtl_tcpのポート" />
     </Grid>
    </StackPanel>
    <DockPanel>
     <StackPanel x:Name="DistributionPanel" Orientation="Horizontal">
      <TextBlock Text="配信ポート" Width="76" VerticalAlignment="Center" />
      <TextBox x:Name="ListenPortBox" Text="11234" Width="80" AutomationProperties.Name="配信ポート" />
     </StackPanel>
     <CheckBox x:Name="LanBox" Content="LANへ配信" VerticalAlignment="Center" Margin="14,0,0,0" ToolTip="ほかのPCから接続するときに有効にします。" />
     <CheckBox x:Name="ReconnectBox" Content="切断時の自動再接続" IsChecked="True" VerticalAlignment="Center" Margin="14,0,0,0" />
    </DockPanel>
   </StackPanel>
  </GroupBox>
  <GroupBox Grid.Row="3" Header="SDRデバイス設定">
   <StackPanel x:Name="SdrPanel">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
     <RadioButton x:Name="ClientControlRadio" Content="クライアントの操作をすべて受け入れる" IsChecked="True" Margin="0,0,12,0" />
     <RadioButton x:Name="ManagedControlRadio" Content="クライアント操作ロック" />
    </StackPanel>
    <WrapPanel x:Name="TuningPanel" IsEnabled="False" TextElement.FontSize="11">
     <TextBlock Text="中心周波数" VerticalAlignment="Center" Margin="0,0,4,0" />
     <TextBox x:Name="FrequencyBox" Text="100" Width="78" AutomationProperties.Name="中心周波数 MHz" />
     <TextBlock Text="MHz" VerticalAlignment="Center" Margin="3,0,4,0" />
     <TextBlock Text="周波数補正(PPM)" VerticalAlignment="Center" Margin="0,0,4,0" />
     <DockPanel PreviewMouseWheel="Ppm_MouseWheel">
      <StackPanel DockPanel.Dock="Right">
       <RepeatButton x:Name="PpmUpButton" Content="▲" Style="{StaticResource SpinButton}" Click="PpmUp_Click" AutomationProperties.Name="周波数補正を1増やす" />
       <RepeatButton x:Name="PpmDownButton" Content="▼" Style="{StaticResource SpinButton}" Click="PpmDown_Click" AutomationProperties.Name="周波数補正を1減らす" />
      </StackPanel>
      <TextBox x:Name="PpmBox" Text="0" Width="38" PreviewKeyDown="Ppm_KeyDown" AutomationProperties.Name="周波数補正(PPM)" />
     </DockPanel>
     <TextBlock Text="Gain" VerticalAlignment="Center" Margin="8,0,4,0" />
     <CheckBox x:Name="AutoGainBox" Content="自動" IsChecked="True" VerticalAlignment="Center" Margin="0,0,4,0" />
     <DockPanel x:Name="GainInput" IsEnabled="False" PreviewMouseWheel="Gain_MouseWheel">
      <StackPanel DockPanel.Dock="Right">
       <RepeatButton x:Name="GainUpButton" Content="▲" Style="{StaticResource SpinButton}" Click="GainUp_Click" AutomationProperties.Name="Gainを1 dB増やす" />
       <RepeatButton x:Name="GainDownButton" Content="▼" Style="{StaticResource SpinButton}" Click="GainDown_Click" AutomationProperties.Name="Gainを1 dB減らす" />
      </StackPanel>
      <TextBox x:Name="GainBox" Text="0" Width="42" PreviewKeyDown="Gain_KeyDown" AutomationProperties.Name="Gain dB" />
     </DockPanel>
     <TextBlock Text="dB" VerticalAlignment="Center" Margin="3,0,4,0" />
     <TextBlock Text="サンプルレート" VerticalAlignment="Center" Margin="0,0,4,0" />
     <ComboBox x:Name="SampleRateBox" Width="62" IsEditable="False" AutomationProperties.Name="サンプルレート MS/s" />
     <TextBlock Text="MS/s" VerticalAlignment="Center" Margin="3,0,0,0" />
    </WrapPanel>
   </StackPanel>
  </GroupBox>
  <GroupBox Grid.Row="4" Header="現在の設定値">
   <TextBlock x:Name="CurrentSettingsText" Text="RTL-TCPから設定値を取得すると表示します。"
              Margin="4,2" TextWrapping="Wrap" />
  </GroupBox>
  <GroupBox Grid.Row="5" Header="接続アプリ">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
     <StackPanel Orientation="Horizontal">
      <Button x:Name="DisconnectButton" Content="切断" Click="Disconnect_Click" />
      <TextBlock Text="周波数変更は全アプリに反映" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#555555" />
     </StackPanel>
    </StackPanel>
    <DataGrid x:Name="ClientsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="22" ColumnHeaderHeight="24" MinHeight="44">
     <DataGrid.Columns>
      <DataGridTextColumn Header="接続元" Binding="{Binding Endpoint}" Width="*" />
      <DataGridTextColumn Header="接続時間" Binding="{Binding Duration}" Width="80" />
      <DataGridTextColumn Header="送信速度" Binding="{Binding Rate}" Width="90" />
      <DataGridTextColumn Header="操作権限" Binding="{Binding Control}" Width="80" />
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
  </GroupBox>
  <GroupBox x:Name="LogGroup" Grid.Row="6" Margin="0,0,2,3" HorizontalContentAlignment="Stretch">
   <GroupBox.Header>
    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type GroupBox}}}">
     <TextBlock Text="ログ" VerticalAlignment="Center" />
     <Button x:Name="ClearLogButton" Content="クリア" MinWidth="48" Padding="3,0" Margin="0,0,20,0" HorizontalAlignment="Right" Click="ClearLog_Click" AutomationProperties.Name="ログをクリア" />
    </Grid>
   </GroupBox.Header>
   <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap" MinHeight="0" FontSize="11" FontFamily="Consolas, Yu Gothic UI" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="通信ログ" />
  </GroupBox>
 </Grid>
 </Border>
</UserControl>
